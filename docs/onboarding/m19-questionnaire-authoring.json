        "audience",
        "preparation_form",
        "submission_method",
        "submission_window"
      ]
    },
    "steps": [
      {
        "text": "进入专攻网站指定的一般选拔用“调查表输入表单”。",
        "claims": [
          "preparation_form"
        ]
      },
      {
        "text": "填写希望的指导教师等信息，选择至第4志愿；填写分配到其他教师时是否愿意入学，选择愿意时继续按表单提示补充信息。",
        "claims": [
          "supervisor_preferences"
        ]
      },
      {
        "text": "保存表单生成的志望调查表PDF。",
        "claims": [
          "preparation_form",
          "submission_method"
        ]
      },
      {
        "text": "在出愿期间，将该PDF上传到网上出愿系统；不要只填写表单而漏传PDF。",
        "claims": [
          "submission_method",
          "submission_window"
        ]
      }
    ],
    "notes": [
      {
        "text": "当前未核验在线表单是否开放、完整字段及具体截止日期或时刻。",
        "claims": [
          "live_form_availability",
          "exact_deadline"
        ]
      },
      {
        "text": "准备情况仅为个人记录，不代表已上传或学校已受理。",
        "claims": [
          "preparation_status"
        ]
      }
    ]
